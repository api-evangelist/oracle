          "id": "cc463c6f-9ef3-4242-af7f-e794c482afd7",
          "name": "Query a trace, span, or service using the Application Performance Monitoring query syntax, and retrieve results (attributes and aggregations) for the queried entity.",
          "request": {
            "name": "Query a trace, span, or service using the Application Performance Monitoring query syntax, and retrieve results (attributes and aggregations) for the queried entity.",
            "description": {
              "content": "Retrieves the results (selected attributes and aggregations) of a query constructed according to the Application Performance Monitoring Defined Query Syntax.\nQuery results are filtered by the filter criteria specified in the where clause.\nFurther query results are grouped by the attributes specified in the group by clause.  Finally,\nordering (asc/desc) is done by the specified attributes in the order by clause.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "queries",
                "actions",
                "runQuery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apmDomainId",
                  "value": "<string>",
                  "description": "(Required) The APM Domain ID for the intended request.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "The maximum number of items to return.\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page token representing the page where to start retrieving results.\nThis is usually retrieved from a previous response.\n"
                },
                {
                  "disabled": false,
                  "key": "timeSpanStartedGreaterThanOrEqualTo",
                  "value": "<dateTime>",
                  "description": "(Required) Include spans that have a `spanStartTime` equal to or greater than this value.\n"
                },
                {
                  "disabled": false,
                  "key": "timeSpanStartedLessThan",
                  "value": "<dateTime>",
                  "description": "(Required) Include spans that have a `spanStartTime`less than this value.\n"
                }
              ],
              "variable": []
            },
            "header": [
