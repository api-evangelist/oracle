{
  "opencollection": "1.0.0",
  "info": {
    "name": "Operator Access Control Access Requests API",
    "version": "20200630"
  },
  "items": [
    {
      "info": {
        "name": "accessRequests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all access requests in the compartment.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1/20200630/accessRequests",
            "headers": [
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "compartmentId",
                "value": "",
                "type": "query",
                "description": "The ID of the compartment in which to list resources."
              },
              {
                "name": "resourceName",
                "value": "",
                "type": "query",
                "description": "A filter to return only resources that match the given ResourceName."
              },
              {
                "name": "lifecycleState",
                "value": "",
                "type": "query",
                "description": "A filter to return only resources whose lifecycleState matches the given AccessRequest lifecycleState."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page token representing the page at which to start retrieving results. This is usually retrieved from a previous list call."
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "The sort order to use, either 'asc' or 'desc'."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "The field to sort by. Only one sort order may be provided. Default order for timeCreated is descending. Default order for displayName is ascending. If no value is specified timeCreated is default.\n"
              }
            ]
          },
          "docs": "Lists all access requests in the compartment.\n"
        },
        {
          "info": {
            "name": "Get GetAccessRequest",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId",
            "headers": [
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              }
            ]
          },
          "docs": "Gets details of an access request."
        },
        {
          "info": {
            "name": "Approves an access request.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId/action/approve",
            "headers": [
              {
                "name": "opc-retry-token",
                "value": ""
              },
              {
                "name": "if-match",
                "value": ""
              },
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Approves an access request.\n"
        },
        {
          "info": {
            "name": "Rejects an access request.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId/action/reject",
            "headers": [
              {
                "name": "opc-retry-token",
                "value": ""
              },
              {
                "name": "if-match",
                "value": ""
              },
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rejects an access request.\n"
        },
        {
          "info": {
            "name": "Revokes an already approved access request.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId/action/revoke",
            "headers": [
              {
                "name": "opc-retry-token",
                "value": ""
              },
              {
                "name": "if-match",
                "value": ""
              },
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Revokes an already approved access request.\n"
        },
        {
          "info": {
            "name": "Get the Audit Log Report for the given access requestId.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId/auditLogReport",
            "headers": [
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              },
              {
                "name": "enableProcessTree",
                "value": "",
                "type": "query",
                "description": "To enable process tree computation in audit report"
              }
            ]
          },
          "docs": "Gets the Audit Log Report for the given access requestId."
        },
        {
          "info": {
            "name": "Gets a history of all state transitions associated with the access request.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1/20200630/accessRequests/:accessRequestId/history",
            "headers": [
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accessRequestId",
                "value": "",
                "type": "path",
                "description": "unique AccessRequest identifier"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page token representing the page at which to start retrieving results. This is usually retrieved from a previous list call."
              }
            ]
          },
          "docs": "Returns a history of all status associated with the accessRequestId.\n"
        }
      ]
    }
  ],
  "bundled": true
}