                "type": "path",
                "description": "Globally distributed database identifier"
              },
              {
                "name": "metadata",
                "value": "",
                "type": "query",
                "description": "Comma separated names of argument corresponding to which metadata need to be retrived.\n"
              }
            ]
          },
          "docs": "Gets the details of the Globally distributed database identified by given id.\n"
        },
        {
