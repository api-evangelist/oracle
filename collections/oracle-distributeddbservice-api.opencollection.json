              {
                "name": "caBundleId",
                "value": "",
                "type": "query",
                "description": "The ID of the Ca Bundle."
              }
            ]
          },
          "docs": "Generate the certificate signing request for GSM instances of the Globally distributed database. Once certificate signing\nrequest is generated, then customers can download the certificate signing request using\n'downloadGsmCertificateSigningRequest' api call.\n"
        },
