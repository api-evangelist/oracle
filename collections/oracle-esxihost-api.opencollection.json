        {
          "info": {
            "name": "Deletes the specified ESXi host",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://127.0.0.1/20220518/esxiHosts/:esxiHostId",
            "headers": [
              {
