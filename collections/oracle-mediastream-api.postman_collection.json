    "_postman_id": "aa164b6f-d4be-43a1-ab31-2ecc3d0b3bda",
    "name": "Media Services Media Stream API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Media Services (includes Media Flow and Media Streams) is a fully managed service for processing media (video) source content. Use Media Flow and Media Streams to transcode and package digital video using configurable workflows and stream video outputs.\n\nUse the Media Services API to configure media workflows and run Media Flow jobs, create distribution channels, ingest assets, create Preview URLs and play assets. For more information, see [Media Flow](/iaas/Content/media-services/mediaflow/mediaflow.htm) and [Media Streams](/iaas/Content/media-services/mediastreams/mediastreams.htm).\n",
      "type": "text/plain"
    }
  }
