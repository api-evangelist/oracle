            ],
            "params": [
              {
                "name": "provisionId",
                "value": "",
                "type": "path",
                "description": "The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the FamProvision."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a Provision."
