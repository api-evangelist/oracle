                  "description": "(Required) Line-level subscription ID.\n"
                },
                {
                  "disabled": false,
                  "key": "timeFrom",
                  "value": "<dateTime>",
                  "description": "Gets the rate cards whose effective start date starts on or after a particular date.\n"
                },
                {
