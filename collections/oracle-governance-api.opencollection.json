            "headers": [
              {
                "name": "if-match",
                "value": ""
              },
              {
                "name": "opc-retry-token",
                "value": ""
              },
              {
                "name": "opc-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "OCID of the organization."
              },
              {
                "name": "organizationTenancyId",
                "value": "",
                "type": "path",
                "description": "OCID of tenancy that is opting in to governance rules."
              }
            ]
          },
          "docs": "Starts a work request to opt the tenancy in to governance rules."
