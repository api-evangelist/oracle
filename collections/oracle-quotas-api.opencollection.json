              {
                "name": "if-match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "quotaId",
                "value": "",
                "type": "path",
                "description": "The OCID of the quota."
              },
              {
                "name": "isLockOverride",
                "value": "",
                "type": "query",
                "description": "Whether to override locks (if any exist)."
              }
            ]
          },
          "docs": "Deletes the quota corresponding to the given OCID."
