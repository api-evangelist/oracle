            "method": "PUT",
            "url": "http://localhost:9090/20181025/quotas/:quotaId",
            "headers": [
              {
                "name": "opc-request-id",
                "value": ""
              },
              {
                "name": "if-match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "quotaId",
                "value": "",
                "type": "path",
                "description": "The OCID of the quota."
              },
              {
                "name": "isLockOverride",
                "value": "",
                "type": "query",
                "description": "Whether to override locks (if any exist)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the quota corresponding to given OCID with the details supplied."
