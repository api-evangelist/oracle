            "params": [
              {
                "name": "oceInstanceId",
                "value": "",
                "type": "path",
                "description": "unique OceInstance identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Moves a OceInstance into a different compartment"
